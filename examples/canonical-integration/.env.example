# ==============================================================================
# Mithaq Canonical Integration Example - Environment Configuration
# ==============================================================================

# ProofRegistry Contract ID (Stellar Testnet)
# Authoritative testnet deployment from DEPLOYMENTS.md
MITHAQ_REGISTRY_ID=CBEXHUMCNS4TJWNYXRFJNIWCNUW62MHAXL4JOBT764CLMHAPNJKIRWXV

# Soroban RPC URL (Stellar Testnet)
MITHAQ_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Passphrase
MITHAQ_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Mithaq Hosted Web App URL (for redirecting holders to verify credentials)
# In production, defaults to https://mithaq.xyz
MITHAQ_BASE_URL=https://mithaq.xyz

# Local Application Settings
PORT=3000
APP_DOMAIN=localhost:3000

# Optional: Comma-separated list of trusted issuer public keys (G...)
# Leave blank to accept credentials from any registered issuer in the IssuerRegistry
TRUSTED_ISSUERS=
